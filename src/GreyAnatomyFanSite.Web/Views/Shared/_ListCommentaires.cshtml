@model GreyAnatomyFanSite.Web.ViewModels.Home.ArticleDetailsPageViewModel

<legend>Commentaires:</legend>
<div class="row">
    @if (Model.Commentaires.Count == 0)
    {
        <div class="col-xs-offset-1 col-md-10 thumbnail">
            <p>Soyez le premier à commenter cette publication!</p>
        </div>
    }
    else
    {
        <ul class="thumbnail media-list">
            @foreach (GreyAnatomyFanSite.Web.ViewModels.Comments.ArticleCommentViewModel comment in Model.Commentaires)
            {
                <li class="media thumbnail">
                    <a class="pull-left" href="#">
                        <img class="media-object imgMiniCommentaires img-circle img-thumbnail" src="~/@comment.AuteurAvatar" alt="@comment.AuteurPseudo" />
                    </a>
                    <div class="media-body">
                        <h4 class="media-heading">@comment.Titre</h4>
                        <p class="miniTextItalic">
                            Publié le @comment.Date.ToString("F", CultureInfo.CreateSpecificCulture("fr-FR"))
                            par
                            <a asp-controller="Membres" asp-action="Show" asp-route-pseudo="@comment.AuteurPseudo">@comment.AuteurPseudo</a>
                        </p>
                        <p>@Html.Raw(comment.Text)</p>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@if (Model.Errors.Count > 0)
{
    <div class="row">
        <div class="col-lg-offset-2 col-lg-8">
            <div class="alert alert-danger">
                @foreach (string error in Model.Errors)
                {
                    <div>@error</div>
                }
            </div>
        </div>
    </div>
}

@await Html.PartialAsync("_RegisterLoginForm", Model)
