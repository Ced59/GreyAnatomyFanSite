@model GreyAnatomyFanSite.Web.ViewModels.Membres.LoginPageViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row">
    <div class="col-lg-offset-3 col-lg-6">
        @if (Model.Errors.Count > 0)
        {
            <div class="row">
                <div class="col-lg-12 alert alert-danger">
                    <div class="Errors">
                        @foreach (string error in Model.Errors)
                        {
                            <div class="row">
                                <div class="col-lg-12">@error</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="row">
                <div class="col-lg-12 alert alert-success">
                    <div class="row">
                        <div class="col-lg-12">@Model.SuccessMessage</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <div class="Login">
            <div class="row">
                <h2 class="col-lg-12">Se connecter</h2>
            </div>
            <form asp-controller="Membres" asp-action="LoginPost" method="post">
                <div class="row">
                    <div class="col-lg-12">
                        <input type="text" class="form-control" name="mail" value="@Model.Mail" placeholder="Votre Adresse Mail" />
                        <input type="hidden" name="typePubli" value="@Model.TypePubli" />
                        <input type="hidden" name="idPubli" value="@Model.IdPubli" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12">
                        <input type="password" class="form-control" name="password" placeholder="Votre Mot de Passe" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <button class="form-control btn btn-default" type="submit">Se connecter</button>
                    </div>
                </div>
            </form>

            <a asp-controller="Membres" asp-action="ChangePassword">Mot de passe oublié?</a>
        </div>
    </div>
</div>
