@model GreyAnatomyFanSite.Web.ViewModels.Membres.ForgotPasswordPageViewModel

@{
    ViewData["Title"] = "Réinitialiser Mot de passe";
}

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        @if (Model.Errors.Count > 0)
        {
            <div class="row">
                <div class="col-lg-12 alert alert-danger">
                    <div class="Errors">
                        @foreach (string error in Model.Errors)
                        {
                            <div class="row">
                                <div class="col-lg-12">@error</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="row">
                <div class="col-lg-12 alert alert-success">
                    <div class="Errors">
                        @Model.SuccessMessage
                        @if (!string.IsNullOrWhiteSpace(Model.DebugActionUrl))
                        {
                            <div class="marginTop2">
                                <a href="@Model.DebugActionUrl">@(Model.DebugActionLabel ?? "Lien de développement")</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <div class="Login">
            <div class="row">
                <h2 class="col-lg-12">Réinitialiser votre mot de passe</h2>
            </div>
            <form asp-controller="Membres" asp-action="ChangePasswordPost" method="post">
                <div class="row">
                    <div class="col-lg-12">
                        <input type="text" class="form-control" name="mail" value="@Model.Mail" placeholder="Votre Adresse Mail" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <button class="form-control btn btn-default" type="submit">Réinitialiser</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
